<% content_for :head do %>
  <%= javascript_include_tag "highcharts", defer: true %>
<% end %>
<%
  gene = ERB::Util.url_encode(@protein.gene_id)
  external_links =
    case @protein.organism
    when 1
      [ [ "Tair", "https://www.arabidopsis.org/servlets/TairObject?type=locus&name=#{gene}" ],
        [ "KEGG", "https://www.genome.jp/dbget-bin/www_bget?ath:#{gene}" ],
        [ "ATTED-II", "https://atted.jp/cgi-bin/locus.cgi?loc=#{gene}" ],
        [ "Phytozome Plant Gene Families", "https://phytozome.jgi.doe.gov/pz/portal.html#!resultssearch=1&crown=1&star=1&method=0&searchText=locusName:#{gene}" ] ]
    when 2 then [ [ "CyanoBase", "http://genome.microbedb.jp/cyanobase/Synechocystis/genes/#{gene}" ] ]
    when 4 then [ [ "CyanoBase", "http://genome.microbedb.jp/cyanobase/SS120/genes/#{gene}" ] ]
    when 5 then [ [ "CyanoBase", "http://genome.microbedb.jp/cyanobase/MED4/genes/#{gene}" ] ]
    when 6 then [ [ "CyanoBase", "http://genome.microbedb.jp/cyanobase/MIT9313/genes/#{gene}" ] ]
    else []
    end
  arabidopsis = @protein.organism == Organism::ARABIDOPSIS
  mode_link = ->(mode) { getchart_path(main_gene_id: @protein.gene_id, material_id: @material.id, mode: mode, gene_id_str: @gene_id_str) }
%>
<div id="view">
  <h1><%= @title %>
    <% if @mode == "1" %>
      <span id="mode_on"> normal</span>
      <%= link_to mode_link.call("2"), class: "mode-link" do %><span id="mode_off"> max100%</span><% end %>
    <% else %>
      <%= link_to mode_link.call("1"), class: "mode-link" do %><span id="mode_off"> normal</span><% end %>
      <span id="mode_on"> max100%</span>
    <% end %>
    <% if external_links.any? %>
      <div class="ext-links">
        <%= safe_join(external_links.map { |label, url| link_to(label, url, target: "_blank", rel: "noopener", title: "Open #{label} in a new tab") }, " · ") %>
      </div>
    <% end %>
  </h1>

  <div class="posttext">
    <p>symbols      :<%= @protein.symbols_tr %></p>
    <p>description :<%= @protein.description_tr %></p>
  </div>

  <%# This form is submitted to two different URLs (reCharts / chart-point click), so it carries
    the session-wide CSRF token instead of a per-form token bound to one URL. %>
  <%= form_tag("/proteins/getchartslist", id: "gel_no_form", authenticity_token: form_authenticity_token,
               data: { point_action: "/proteins/getchartlist" }) do %>
    <%= hidden_field_tag :material_id, @material.id, id: "material_id" %>
    <%= hidden_field_tag :gel_no, @selected_gel_no, id: "gel_no" %>
    <%= hidden_field_tag :main_gene_id, @protein.gene_id, id: "main_gene_id" %>
    <%= hidden_field_tag :mode, @mode, id: "mode" %>
    <%= hidden_field_tag :gene_id_str, @gene_id_str, id: "gene_id_str" %>

    <!-- chart -->
    <div id="chart_container" style="width:580px;height:400px;"
         data-mode="<%= @mode %>"
         data-chartsets="<%= @chartsList.map(&:to_h).to_json %>"></div>

    <!-- weight table -->
    <div id="weighttable">
      <table class="weight_table">
        <tr>
          <td class="colm_name">gel_no</td>
          <% @material.materialweights.each do |weight| %>
            <td class="gel<%= @material.grid_disp %>"><%= weight.gel_no if weight.weight.to_i > 0 %></td>
          <% end %>
        </tr>
        <tr>
          <td class="colm_name">mw</td>
          <% @material.materialweights.each do |weight| %>
            <td class="gel<%= @material.grid_disp %>"><%= weight.weight.round if weight.weight.to_i > 0 %></td>
          <% end %>
        </tr>
      </table>
    </div>

    <!-- peak list -->
    <% if @msresults %>
      <table>
        <tr>
          <td><%= submit_tag "reCharts", id: "recharts_button", class: "button1" %></td>
          <td><input class="button1" type="button" id="check_all" value="AllCheck"></td>
          <td><input class="button1" type="button" id="check_clear" value="Clear"></td>
          <td class="posttext"><%= image_tag "yajirushi_green01.jpg", alt: "" %>   point selected  :  gel_no_<%= @selected_gel_no %></td>
        </tr>
      </table>

      <table cellpadding="0" cellspacing="0" border="0" id="table" class="sortable" data-sorter data-sort-column="1" data-paginate="false">
        <thead>
          <tr>
            <th class="nosort" style="width:10px"><h3>　</h3></th>
            <th style="width:<%= arabidopsis ? 70 : 60 %>px"><h3>gene_id</h3></th>
            <th style="width:10px"><h3>peak</h3></th>
            <th style="width:30px"><h3>emPAI</h3></th>
            <th style="width:30px"><h3>/max emPAI<br>(%)</h3></th>
            <th style="width:25px"><h3>mw</h3></th>
            <th style="width:<%= arabidopsis ? 80 : 60 %>px"><h3>symbols</h3></th>
            <th style="width:<%= arabidopsis ? 200 : 80 %>px"><h3>description</h3></th>
            <% unless arabidopsis %>
              <th style="width:40px"><h3>Arabidopsis<br>gene_id</h3></th>
              <th style="width:60px"><h3>Arabidopsis<br>symbols</h3></th>
              <th style="width:80px"><h3>Arabidopsis<br>description</h3></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @msresults.each do |result| %>
            <% main = result.gene_id == @main_gene_id %>
            <% protein = result.protein %>
            <% cell_style = main ? "background:#c6c6db;" : "" %>
            <tr>
              <td style="<%= cell_style %>">
                <%= check_box_tag "gene_id[#{result.gene_id}]", "1", main || result.check,
                                  id: "gene_id_#{result.gene_id}", disabled: main %>
              </td>
              <td style="<%= cell_style %>">
                <%= link_to getchart_path(main_gene_id: result.gene_id, material_id: @material.id, mode: "1", gene_id_str: arabidopsis ? "" : @gene_id_str) do %>
                  <span class="widelink"><%= result.gene_id %></span>
                <% end %>
              </td>
              <td style="<%= cell_style %>text-align: center;"><%= result.peak == 1 ? "P" : "　" %></td>
              <td style="<%= cell_style %>text-align: right;"><%= format("%.2f", result.empai.to_f).to_f %></td>
              <td style="<%= cell_style %>text-align: right;"><%= format("%.1f", result.empai_rt.to_f).to_f %></td>
              <td style="<%= cell_style %>text-align: right;"><%= protein && protein.weight.to_f > 0 ? protein.weight.round : " 　-" %></td>
              <td style="<%= cell_style %>"><%= protein&.symbols_tr %></td>
              <td style="<%= cell_style %>"><%= protein&.description_tr %></td>
              <% unless arabidopsis %>
                <td style="<%= cell_style %>"><%= protein&.arabi_gene_id %></td>
                <td style="<%= cell_style %>"><%= protein&.arabi_symbols_tr %></td>
                <td style="<%= cell_style %>"><%= protein&.arabi_description_tr %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
</div>
