<div id="view">
  <h1>search protein</h1>
  <table cellpadding="0" cellspacing="0" border="0" id="table" class="sortable" data-sorter data-sort-column="0" data-paginate="true">
    <thead>
      <tr>
        <th style="width:90px"><h3>gene_id</h3></th>
        <th style="width:120px"><h3>symbols</h3></th>
        <th style="width:360px"><h3>description</h3></th>
      </tr>
    </thead>
    <tbody>
      <% @msresults.each do |result| %>
        <% protein = result.protein %>
        <tr data-href="<%= search_protein_path(gene_id: result.gene_id) %>">
          <td>
            <%= link_to search_protein_path(gene_id: result.gene_id) do %>
              <span class="widelink"><%= result.gene_id %></span>
            <% end %>
          </td>
          <td><%= protein&.symbols.presence ? protein.symbols_tr : "　" %></td>
          <td><%= protein&.description_tr %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "pager" %>
</div>
