<div id="view">
  <h1><%= @material.material_name %></h1>

  <%= form_tag("/proteins/search_list_protein_by_gene_id", id: "search_key_form_by_gene_id") do %>
    <%= hidden_field_tag :material_id, @material.id %>
    <table class="key_table">
      <tr>
        <td class="posttext">　1>　</td>
        <td class="posttext">gene_id: <%= render "help_gene_id_link" %></td>
        <td><%= text_field_tag :search_gene_id, @search_gene_id, class: "gene_id", maxlength: 15, data: { gene_id: true } %></td>
        <td><%= submit_tag "search 1", id: "search_button1", class: "button1" %></td>
      </tr>
    </table>
  <% end %>

  <%= form_tag("/proteins/search_list_protein_by_symbols_or_description", id: "search_key_form_by_symbols_or_description") do %>
    <%= hidden_field_tag :material_id, @material.id %>
    <table class="key_table">
      <tr>
        <td class="posttext" rowspan="2">　2>　</td>
        <td class="posttext">symbols:</td>
        <td><%= text_field_tag :symbols, @search_symbols, class: "symbols", maxlength: 200 %></td>
        <td rowspan="2"><%= submit_tag "search 2", id: "search_button2", class: "button1" %></td>
      </tr>
      <tr>
        <td class="posttext">description:</td>
        <td><%= text_field_tag :description, @search_description, class: "description", maxlength: 200 %></td>
      </tr>
    </table>
  <% end %>

  <% arabidopsis = @material.organism_id == Organism::ARABIDOPSIS %>
  <table id="table" class="sortable" data-sorter data-sort-column="0" data-paginate="true">
    <thead>
      <tr>
        <% if arabidopsis %>
          <th style="width:90px"><h3>gene_id</h3></th>
          <th style="width:120px"><h3>symbol</h3></th>
          <th style="width:360px"><h3>description</h3></th>
        <% else %>
          <th style="width:45px"><h3>gene_id</h3></th>
          <th style="width:60px"><h3>symbols</h3></th>
          <th style="width:180px"><h3>description</h3></th>
          <th style="width:45px"><h3>Arabidopsis<br>gene_id</h3></th>
          <th style="width:60px"><h3>Arabidopsis<br>symbols</h3></th>
          <th style="width:180px"><h3>Arabidopsis<br>description</h3></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @list_protein.each do |result| %>
        <% protein = result.protein %>
        <tr>
          <td>
            <%= link_to getchart_path(main_gene_id: result.gene_id, material_id: @material.id, gene_id_str: "", mode: "1") do %>
              <span class="widelink"><%= result.gene_id %></span>
            <% end %>
          </td>
          <td><%= protein&.symbols_tr %></td>
          <td><%= protein&.description_tr %></td>
          <% unless arabidopsis %>
            <td><%= protein&.arabi_gene_id %></td>
            <td><%= protein&.arabi_symbols_tr %></td>
            <td><%= protein&.arabi_description_tr %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "pager" %>
</div>
