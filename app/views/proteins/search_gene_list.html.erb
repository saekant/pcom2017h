<div id="view">
  <h1><%= @material.material_name %></h1>
  <%= render "legend" %>

  <% @entries.each do |entry| %>
    <% protein = entry[:protein] %>
    <% if protein.nil? %>
      <div class="posttext">
        <p>The query (Input value "<%= entry[:input] %>") was not found in the genome database. Try another query.</p>
      </div>
    <% else %>
      <% chart_path = getchart_path(main_gene_id: protein.gene_id, gene_id_str: @gene_id_str, material_id: @material.id, mode: "1") %>
      <div class="posttext">
        <p>gene_id　　　  : <%= protein.gene_id %>　／symbols　　　: <%= protein.symbols_tr %></p>
        <p>description　　: <%= protein.description_tr %></p>
      </div>
      <table class="mas_table">
        <tr data-href="<%= chart_path %>">
          <% if entry[:levels].any? %>
            <td class="material_name"><%= link_to protein.gene_id, chart_path %></td>
            <%= render "bars", levels: entry[:levels], css: "gel#{@material.grid_disp}" %>
          <% else %>
            <td class="material_name"><%= protein.gene_id %> :   no data</td>
          <% end %>
        </tr>
      </table>
    <% end %>
  <% end %>
</div>
