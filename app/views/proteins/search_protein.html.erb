<div id="view">
  <h1><%= @title %></h1>
  <% if @protein.nil? %>
    <div class="posttext">
      <p>The query was not found in the genome database. Try another query.</p>
    </div>
  <% else %>
    <div class="posttext">
      <p>symbols      : <%= @protein.symbols_tr %></p>
      <p>description :<%= @protein.description_tr %></p>
    </div>

    <%= render "legend" %>

    <% if @organism == Organism::ARABIDOPSIS %>
      <% Material::ARABIDOPSIS_ROWS.each do |row| %>
        <table class="mas_table">
          <tr>
            <% if (levels = @levels[row.id]) %>
              <td class="material_name">
                <%= link_to row.label, getchart_path(material_id: row.id, main_gene_id: @title, gene_id_str: "", mode: "1") %>
              </td>
              <%= render "bars", levels: levels, css: row.css %>
            <% else %>
              <td class="material_name"><%= row.label %>    :   no data</td>
            <% end %>
          </tr>
        </table>
      <% end %>
    <% end %>

    <% if @arabi_homolog_flg %>
      <h1>Homolog</h1>
    <% end %>

    <% Material::OTHER_ROWS.each do |row| %>
      <% next unless @organism == row.organism_id || @arabi_homolog_flg %>
      <table class="mas_table">
        <tr>
          <% if (levels = @levels[row.id]) %>
            <td class="material_name">
              <% if @organism == row.organism_id %>
                <%= link_to row.label, getchart_path(material_id: row.id, main_gene_id: @title, gene_id_str: "", mode: "1") %>
              <% elsif (homolog = @homolog_gene_ids[row.id]) %>
                <%= link_to "#{row.label} :#{homolog}", getchart_path(material_id: row.id, main_gene_id: homolog, gene_id_str: "", mode: "1") %>
              <% end %>
            </td>
            <%= render "bars", levels: levels, css: row.css %>
          <% else %>
            <td class="material_name"><%= row.label %>  :   no data</td>
          <% end %>
        </tr>
      </table>
    <% end %>
  <% end %>
</div>
