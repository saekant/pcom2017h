<div id="view">
  <h1><%= @title %></h1>
  <%= form_tag("/proteins/key_proteins", id: "search_key_form_by_gene_list") do %>
    <table class="key_table">
      <tr>
        <td class="posttext">sample:</td>
        <td><%= select_tag :material_id, option_groups_from_collection_for_select(@organisms, :materials, :organism_name, :id, :material_name) %></td>
        <td></td>
      </tr>
      <tr>
        <td class="posttext">gene_id:</td>
        <td><%= text_area_tag :gene_id_list, "", cols: 10, rows: 10, data: { gene_list: true } %></td>
        <td valign="bottom"><%= submit_tag "search", id: "search_button", class: "button1" %></td>
      </tr>
      <tr>
        <td class="posttext">Example　:</td>
        <td>sample:chloroplast<br>gene_id:AT5G04140,AT1G16880</td>
      </tr>
    </table>
  <% end %>
</div>
