<div id="view">
  <h1><%= @title %></h1>
  <%= form_tag("/proteins/search_protein", id: "search_key_form_by_gene_id") do %>
    <table class="key_table">
      <tr>
        <td class="posttext">　1>　</td>
        <td class="posttext">gene_id: <%= render "help_gene_id_link", size: "400x700" %></td>
        <td class="posttext"><%= text_field_tag :search_gene_id, "", class: "gene_id", maxlength: 15, data: { gene_id: true } %></td>
        <td><%= submit_tag "search 1", id: "search_button", class: "button1" %>
          　Example：AT5G04140
        </td>
      </tr>
    </table>
  <% end %>

  <%= form_tag("/proteins/search_key_form_by_symbols_or_description", id: "search_key_form_by_symbols_or_description") do %>
    <table class="key_table">
      <tr>
        <td class="posttext" rowspan="2">　2>　</td>
        <td class="posttext">symbols:</td>
        <td><%= text_field_tag :symbols, "", class: "symbols", maxlength: 200 %></td>
        <td rowspan="2"><%= submit_tag "search 2", id: "search_button2", class: "button1" %></td>
        <td>Example：GLU1</td>
      </tr>
      <tr>
        <td class="posttext">description:</td>
        <td><%= text_field_tag :description, "", class: "description", maxlength: 200 %></td>
        <td>Example：glutamate synthase</td>
      </tr>
    </table>
  <% end %>
</div>
