</head>
<body id="body_top">
<div id="container">
  <div id="head_top">
    <div id="header">
      <div id="header_inner">
        <table style="width: 572px;">
          <tr><td><%= image_tag "title.png", width: 512, alt: "PCoM-DB" %></td></tr>
          <tr><td align="right"><h6> ver 2.1　last update:2023.06.02 (Bugs fixed.)</h6></td></tr>
        </table>
        <br>
        <%= render "layouts/menu" %>
