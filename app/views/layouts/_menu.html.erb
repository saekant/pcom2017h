<%
  browse = [
    [ "Arabidopsis thaliana",                   [ [ "chloroplast", 3 ], [ "chloroplast 2", 4 ], [ "mitochondria", 18 ], [ "envelope", 10 ], [ "stroma", 5 ], [ "thylakoid", 1 ] ] ],
    [ "Physcomitrella patens",                  [ [ "whole cells", 17 ] ] ],
    [ "<i>Chlamydomonas reinhardtii</i>",       [ [ "whole cells", 13 ] ] ],
    [ "Synechosystis sp. PCC6803",              [ [ "whole cells", 9 ] ] ],
    [ "<i>Thermosynechococcus elongatus</i> BP-1", [ [ "whole cells", 30 ] ] ],
    [ "<i>Prochlorococcus</i> CCMP1986",        [ [ "whole cells", 15 ] ] ],
    [ "<i>Prochlorococcus</i> CCMP1375",        [ [ "whole cells", 14 ] ] ],
    [ "<i>Prochlorococcus</i> CCMP2773",        [ [ "whole cells", 16 ] ] ]
  ]
%>
<ul class="menu">
  <li><%= link_to "Top", "/proteins/top" %>
    <ul class="sub">
      <li><%= link_to "Overview", "/proteins/overview" %></li>
      <li><%= link_to "Help", "/proteins/help" %></li>
      <li><%= link_to "Resources", "/proteins/resources" %></li>
      <li><%= link_to "About us", "/proteins/aboutus" %></li>
    </ul>
  </li>
  <li><a href="#">Search</a>
    <ul class="sub">
      <li><%= link_to "Single protein search", "/proteins/key_protein" %></li>
      <li><%= link_to "Multiple protein search", "/proteins/key_proteins" %></li>
    </ul>
  </li>
  <li><a href="#">Browse</a>
    <% browse.each do |organism, samples| %>
      <ul class="sub">
        <li><a href="#"><%= sanitize organism, tags: %w[i] %></a>
          <ul class="sub">
            <% samples.each do |label, material_id| %>
              <li><%= link_to label, "/proteins/list_protein?material_id=#{material_id}" %></li>
            <% end %>
          </ul>
        </li>
      </ul>
    <% end %>
  </li>
</ul>
