<!doctype html>
<html lang="en">
<head>
  <%= render "layouts/head" %>
</head>
<body id="body_normal">
<div id="container">
  <div id="header_normal">
    <div id="header">
      <div id="header_inner">
        <table>
          <tr>
            <td><%= image_tag "lowtemp.png", alt: "Institute of Low Temperature Science" %></td>
            <td style="width: 330px;"><h3>PCoM-DB</h3></td>
            <td><h5>Protein co-migration database for photosynthetic organisms</h5></td>
          </tr>
        </table>
        <%= render "layouts/menu" %>
      </div>
    </div>
  </div>

  <div id="content">
    <%= yield %>
  </div>
  <div id="foot">
    <%= render "layouts/foot" %>
  </div>
</div>
</body>
</html>
