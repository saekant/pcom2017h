# Bundler / Ruby
/.bundle
/vendor/bundle

# Environment, keys and credentials (never commit)
/.env*
/config/master.key
/config/credentials/*.key
/config/credentials.yml.enc

# Logs, temp files, local databases
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
*.sqlite3
*.sqlite3-*
*.dump

# Compiled assets
/public/assets

# Node (not used by this app)
/node_modules

# OS / editor files
.DS_Store
*.swp
.idea/
.vscode/
